# .env.example
# Copy to .env.local and fill in. Next.js, drizzle-kit and the seed script all read .env.local.

# App
APP_URL=http://localhost:3000

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth (secret: at least 32 characters, e.g. `npx @better-auth/cli secret`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed: this user's role becomes admin when you run npm run db:seed (optional)
SEED_ADMIN_EMAIL=

# Cron: protects /api/cron/expire-holds (Step 2)
CRON_SECRET=

# Cloudinary image uploads: Cloudinary dashboard -> Settings -> API Keys. Only these three are needed.
# (Optional: CLOUDINARY_FOLDER=turfzone sets the top folder; it's created on the first upload.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SSLCommerz (Step 2). SSLCZ_IS_LIVE=false uses the sandbox
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false

# bKash Tokenized Checkout (direct "Pay with bKash"). From the bKash merchant/sandbox onboarding email.
# Leave all four empty to hide the bKash option. BKASH_IS_LIVE=false uses the bKash sandbox.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_LIVE=false

# Brevo transactional email (registration OTP + booking receipt). API key from Brevo -> SMTP & API -> API keys.
# BREVO_SENDER_EMAIL must be a verified sender or domain in Brevo, or sends are rejected.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Ticket QR signing key (Step 7b). 32+ random characters, keep it secret.
# Rotating it invalidates every ticket QR printed before.
TICKET_SECRET=

# Control room: /control-room/<ADMIN_OVERRIDE_SLUG> lets an admin set the revenue figures shown on /admin.
# Use a long, hard-to-guess slug and password. Leave both empty to switch the page off.
ADMIN_OVERRIDE_SLUG=
ADMIN_OVERRIDE_PASSWORD=
