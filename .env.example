# .env.example
# Copy to .env.local and fill in. Next.js, drizzle-kit and the seed script all read .env.local.

# App
APP_URL=http://localhost:3000

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth (secret: at least 32 characters, e.g. `npx @better-auth/cli secret`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed: this user's role becomes admin when you run npm run db:seed (optional)
SEED_ADMIN_EMAIL=

# Cron: protects /api/cron/expire-holds (Step 2)
CRON_SECRET=

# Cloudinary uploads (Step 5)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turfzone

# SSLCommerz (Step 2). SSLCZ_IS_LIVE=false uses the sandbox
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
